{% if hero_image_url %}
<div style="text-align:center;margin:0 0 24px;">
  <img src="{{ hero_image_url }}" alt="{{ draft.image_alt }}" width="1200" style="max-width:100%;height:auto;border-radius:8px;" loading="eager">
</div>
{% endif %}
{% for p in hook_paragraphs %}
<p style="font-size:1.2em;line-height:1.8;font-weight:500;">{{ p }}</p>
{% endfor %}

<h2>핵심 내용</h2>
<ul>
{% for point in draft.key_points %}
  <li>{{ point }}</li>
{% endfor %}
</ul>
{% if skill %}

<div style="padding:16px;background:#f4f6fa;border:1px solid #dfe3ea;border-radius:10px;margin:16px 0;">
  <p style="margin:0 0 8px;font-weight:bold;">🧩 {{ skill.name }} 한눈에 보기</p>
  <ul style="margin:0 0 10px;padding-left:18px;">
    <li>누적 설치 {{ '{:,}'.format(skill.installs) }}회 · GitHub 별 {{ '{:,}'.format(skill.stars) }}개</li>
    <li>저장소: <a href="{{ skill.github_url }}" target="_blank" rel="noopener nofollow">{{ skill.ref.owner_repo }}</a></li>
{% if skill.audits_clean %}
    <li>보안 감사 3종 모두 통과 (skills.sh 기준)</li>
{% endif %}
  </ul>
  <p style="margin:0 0 4px;font-size:0.9em;color:#555;">터미널에 붙여 넣으면 설치됩니다.</p>
  <pre style="margin:0;padding:10px 12px;background:#1e1e1e;color:#f5f5f5;border-radius:6px;overflow-x:auto;white-space:pre;"><code>{{ skill.install_cmd }}</code></pre>
</div>
{% endif %}
{% if tool %}

<p style="padding:14px 16px;background:#e8f0fe;border-radius:8px;">🧮 <strong>내 경우는 얼마일까?</strong> {{ tool.blurb }}<br>
  <a href="{{ tool.url }}" target="_blank" rel="noopener" style="font-weight:bold;">{{ tool.title }} 바로 가기 →</a></p>
{% endif %}

{% if as_of_note %}
<p style="font-size:0.9em;color:#555;">{{ as_of_note }}</p>
{% endif %}

{% for heading, blocks, tip in sections %}
<h2>{{ heading }}</h2>
{% for b in blocks %}
{% if b.kind == 'ol' %}
<ol>
{% for item in b.items %}
  <li>{{ item }}</li>
{% endfor %}
</ol>
{% elif b.kind == 'q' %}
<h3>{{ b.text }}</h3>
{% else %}
<p>{{ b.text }}</p>
{% endif %}
{% endfor %}
<p style="padding:12px 16px;background:#fff8e6;border-left:4px solid #f5b400;border-radius:4px;">💡 <strong>꿀팁</strong> · {{ tip }}</p>
{% endfor %}

<h2>그래서 나에게 무엇이 달라질까</h2>
<p>{{ draft.why_it_matters }}</p>

<h2>내일 바로 써먹기</h2>
<ol>
{% for item in draft.action_items %}
  <li>{{ item }}</li>
{% endfor %}
</ol>

{% if draft.glossary %}
<h3>용어사전</h3>
<ul>
{% for item in draft.glossary %}
  <li><strong>{{ item.term }}</strong> · {{ item.meaning }}</li>
{% endfor %}
</ul>

{% endif %}
<h3>출처</h3>
<ul>
{% if via_url %}
  <li>원문: <a href="{{ source_url }}" target="_blank" rel="noopener nofollow">{{ source_url }}</a></li>
  <li>via <a href="{{ via_url }}" target="_blank" rel="noopener">{{ source_name }}</a></li>
{% else %}
  <li>{{ source_prefix }}: {{ source_name }} · <a href="{{ source_url }}" target="_blank" rel="noopener nofollow">{{ source_url }}</a></li>
{% endif %}
{% for ref in references %}
  <li>{{ reference_prefix }}: {% if ref.source != ref.title %}{{ ref.source }} · {% endif %}<a href="{{ ref.url }}" target="_blank" rel="noopener nofollow">{{ ref.title }}</a></li>
{% endfor %}
</ul>
{% if money_note %}
<p style="font-size:0.9em;color:#666;">{{ money_note }}</p>
{% endif %}
{% if short_news %}

<h3>오늘의 짧은 소식</h3>
<ul>
{% for news in short_news %}
  <li><a href="{{ news.url }}" target="_blank" rel="noopener">{{ news.title }}</a> · {{ news.one_line }}</li>
{% endfor %}
</ul>
{% endif %}
{% if related %}

<h3>함께 읽으면 좋은 글</h3>
<ul>
{% for post in related %}
  <li><a href="{{ post.url }}">{{ post.title }}</a></li>
{% endfor %}
</ul>
{% endif %}

{% if footer_url %}

<div style="margin-top:40px;padding:20px;text-align:center;background:#fff8ee;border:1px solid #f3dcb8;border-radius:8px;">
  <p style="margin:0 0 12px;">오늘 글이 재미있으셨다면, 제 공간에도 한 번 놀러 와 주세요 🙂</p>
  <a href="{{ footer_url }}" target="_blank" rel="noopener" style="display:inline-block;padding:10px 22px;background:#ff8a3d;color:#fff;border-radius:999px;text-decoration:none;font-weight:bold;">제 인포크 링크 둘러보기</a>
</div>
{% endif %}
