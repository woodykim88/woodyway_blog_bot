{#- 2026-10-22: 색·모양은 테마(theme/jungbomaster-theme.xml)의 im-* 클래스가 정한다. 본문은 차분한 흰 바탕(A안). 이모지 없음. -#}
{% if hero_image_url %}
<div class="im-hero">
  <img src="{{ hero_image_url }}" alt="{{ draft.image_alt }}" width="1200" height="800" loading="eager">
</div>
{% endif %}
{% for p in hook_paragraphs %}
<p class="im-lead">{{ p|md }}</p>
{% endfor %}
{% if tool %}
<div class="im-calc">
  <p><strong>내 경우는 얼마일까?</strong> {{ tool.blurb }}</p>
  <a class="im-btn" href="{{ tool.url }}" target="_blank" rel="noopener">{{ tool.title }} 바로 가기 →</a>
</div>
{% endif %}
{% set summary_card = infographic.get('summary') %}
{% if summary_card %}
<div class="im-figure">
  <img src="{{ summary_card[0] }}" alt="{{ summary_card[1] }}" width="1000" loading="lazy">
</div>
{% endif %}

<h2>핵심 내용</h2>
<ul class="im-points">
{% for point in draft.key_points %}
  <li>{{ point|md }}</li>
{% endfor %}
</ul>
{% if skill %}

<div class="im-box">
  <p class="im-box-title">{{ skill.name }} 한눈에 보기</p>
  <ul>
    <li>누적 설치 {{ '{:,}'.format(skill.installs) }}회 · GitHub 별 {{ '{:,}'.format(skill.stars) }}개</li>
    <li>저장소: <a href="{{ skill.github_url }}" target="_blank" rel="noopener nofollow">{{ skill.ref.owner_repo }}</a></li>
{% if skill.audits_clean %}
    <li>보안 감사 3종 모두 통과 (skills.sh 기준)</li>
{% endif %}
  </ul>
  <p class="im-muted">터미널에 붙여 넣으면 설치됩니다.</p>
  <pre class="im-code"><code>{{ skill.install_cmd }}</code></pre>
</div>
{% endif %}

{% if as_of_note %}
<p class="im-asof">{{ as_of_note }}</p>
{% endif %}

{% for heading, blocks, tip, picture in sections %}
<h2>{{ heading }}</h2>
{% for b in blocks %}
{% if b.kind == 'ol' %}
<ol>
{% for item in b.items %}
  <li>{{ item|md }}</li>
{% endfor %}
</ol>
{% elif b.kind == 'q' %}
<h3>{{ b.text|md }}</h3>
{% else %}
<p>{{ b.text|md }}</p>
{% endif %}
{% endfor %}
<p class="im-tip"><strong>꿀팁</strong> · {{ tip|md }}</p>
{% if loop.index0 == 0 and featured %}
<p class="im-related">함께 보면 좋은 글: <a href="{{ featured.url }}">{{ featured.title }}</a></p>
{% endif %}
{% if picture %}
<div class="im-figure">
  <img src="{{ picture[0] }}" alt="{{ picture[1] }}" width="1000" loading="lazy">
</div>
{% endif %}
{% endfor %}

<h2>그래서 나에게 무엇이 달라질까</h2>
<p>{{ draft.why_it_matters|md }}</p>

<h2>내일 바로 써먹기</h2>
<ol>
{% for item in draft.action_items %}
  <li>{{ item|md }}</li>
{% endfor %}
</ol>
{% if tool %}
<div class="im-calc im-calc-end">
  <p>다 읽으셨다면 내 숫자로 확인해 보세요.</p>
  <a class="im-btn" href="{{ tool.url }}" target="_blank" rel="noopener">{{ tool.title }} 바로 가기 →</a>
</div>
{% endif %}
{% set checklist_card = infographic.get('checklist') %}
{% if checklist_card %}
<div class="im-figure">
  <img src="{{ checklist_card[0] }}" alt="{{ checklist_card[1] }}" width="1000" loading="lazy">
</div>
{% endif %}

{% if draft.glossary %}
<h3>용어사전</h3>
<ul>
{% for item in draft.glossary %}
  <li><strong>{{ item.term }}</strong> · {{ item.meaning|md }}</li>
{% endfor %}
</ul>

{% endif %}
<h3>출처</h3>
<ul class="im-sources">
{% if via_url %}
  <li>원문: <a href="{{ source_url }}" target="_blank" rel="noopener nofollow">{{ source_url }}</a></li>
  <li>via <a href="{{ via_url }}" target="_blank" rel="noopener">{{ source_name }}</a></li>
{% else %}
  <li>{{ source_prefix }}: {{ source_name }} · <a href="{{ source_url }}" target="_blank" rel="noopener nofollow">{{ source_url }}</a></li>
{% endif %}
{% for ref in references %}
  <li>{{ reference_prefix }}: {% if ref.source != ref.title %}{{ ref.source }} · {% endif %}<a href="{{ ref.url }}" target="_blank" rel="noopener nofollow">{{ ref.title }}</a></li>
{% endfor %}
</ul>
{% if money_note %}
<p class="im-muted">{{ money_note }}</p>
{% endif %}
{% if short_news %}

<h3>오늘의 짧은 소식</h3>
<ul>
{% for news in short_news %}
  <li><a href="{{ news.url }}" target="_blank" rel="noopener">{{ news.title }}</a> · {{ news.one_line }}</li>
{% endfor %}
</ul>
{% endif %}
{% if related %}

<h3>함께 읽으면 좋은 글</h3>
<ul class="im-more">
{% for post in related %}
  <li><a href="{{ post.url }}">{{ post.title }}</a></li>
{% endfor %}
</ul>
{% endif %}

{% if footer_url %}

<div class="im-box im-footer">
  <p>오늘 글이 도움이 되셨다면, 제 공간에도 한 번 놀러 와 주세요.</p>
  <a class="im-btn" href="{{ footer_url }}" target="_blank" rel="noopener">제 인포크 링크 둘러보기</a>
</div>
{% endif %}
