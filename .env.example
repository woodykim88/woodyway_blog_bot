# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env 는 Git에 올리지 않습니다.
BLOG_ID=6191091407195774034

# 로컬 실행 시 파일 경로 (기본값 그대로 두면 됨)
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# 서버(GitHub Actions) 전용: 아래 3개가 모두 있으면 token.json 대신 사용
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 모든 글 하단 링크 (비우면 표시 안 함)
FOOTER_LINK_URL=https://link.inpock.co.kr/shoperwoody

# AI 설정 (관리 화면 "AI 설정"에서 바꾸면 GitHub Variables와 이 파일이 함께 바뀜)
TEXT_PROVIDER=openai          # openai / gemini / anthropic
WRITER_MODEL=gpt-5.5
FAST_MODEL=gpt-5.4-mini
IMAGE_PROVIDER=openai         # openai / gemini
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium          # low / medium / high

# AI 회사별 키 (쓰는 회사 것만 있으면 됨)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 발행 시각 (KST, 쉼표로 최대 3개) · 일시정지
PUBLISH_TIMES=20:00
PAUSED=false

# Cloudflare R2 (대표 이미지 저장소). 5개 모두 채우거나 모두 비우세요.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=woodyway-blog-images
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
